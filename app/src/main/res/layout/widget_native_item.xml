<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="45dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/item_start_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="08:00"
            android:textColor="#E0E0E0"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/item_end_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="09:00"
            android:textColor="#888888"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/item_color_bar"
        android:layout_width="5dp"
        android:layout_height="34dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:scaleType="fitXY"
        android:src="@drawable/shape_rounded_bar" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="标题"
            android:textColor="#E0E0E0"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/item_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="副标题"
            android:textColor="#888888"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/item_ongoing_badge_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/item_ongoing_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/shape_rounded_bar"
            android:scaleType="fitXY" />

        <TextView
            android:id="@+id/item_ongoing_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="上课中"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp" />
    </FrameLayout>

    <ImageView
        android:id="@+id/item_check_box"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_check_circle_outline"
        android:tint="#888888"
        android:visibility="gone" />

</LinearLayout>